# -----------------------------------------------------------------------------
# AURA configuration TEMPLATE.
#
# 1. Copy this file and rename the copy to ".env"
# 2. Fill in your real values (especially the API key)
#
# The real ".env" file is listed in .gitignore, so it is NEVER committed to Git.
# This ".env.example" is safe to commit because it contains no real secrets.
# -----------------------------------------------------------------------------

# Which brain provider to use. Supported values: "nemotron", "anthropic".
# AURA picks the matching brain automatically via the provider factory.
AURA_LLM_PROVIDER=nemotron

# ----- NVIDIA Nemotron (default; free developer endpoint) -----
# Get a free API key at https://build.nvidia.com/  (create an account, then
# "Get API Key"). No credit card needed. The key looks like a long random string.
AURA_NVIDIA_API_KEY=paste-your-nvidia-key-here

# NVIDIA's OpenAI-compatible endpoint. Leave this as-is unless you self-host NIM.
AURA_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ----- Anthropic / Claude (optional alternative) -----
# Only needed if you set AURA_LLM_PROVIDER=anthropic.
AURA_ANTHROPIC_API_KEY=paste-your-key-here

# The model for whatever provider is currently selected. Model names change over
# time; if you get a "model not found" error, copy the current model ID from that
# provider's catalog and paste it here.
AURA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Response "creativity": 0.0 = focused/deterministic, 1.0 = more creative.
AURA_TEMPERATURE=0.7
